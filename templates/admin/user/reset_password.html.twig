{% extends '@SonataAdmin/CRUD/action.html.twig' %}

{% block title %}
    Change Password
{% endblock %}

{% block content %}
    <div class="sonata-ba-form">
        {{ form_start(form, {'action': admin.generateUrl('reset_password', {'id': object.id}), 'method': 'POST'}) }}
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header">
                        <h4 class="box-title">
                            Change password for user: {{ object.email }}
                        </h4>
                    </div>
                    <div class="box-body">
                        {{ form_widget(form) }}
                    </div>
                </div>
            </div>
        </div>
        <div class="sonata-ba-form-actions well well-small form-actions">
            <button type="submit" class="btn btn-success" name="btn_update"><i class="fas fa-save" aria-hidden="true"></i> Change password</button>
            <a class="btn btn-danger" href="{{ admin.generateUrl('list') }}"><i class="fas fa-times" aria-hidden="true"></i> Cancel</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
